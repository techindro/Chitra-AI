# ==============================================================
# Chitra-AI / Khicho.AI Environment Variables
# ==============================================================

# [BACKEND - server.js]
# Port for the Node.js / Express backend server (default: 3001)
PORT=3001

# RunwayML API Key (Required for high-quality Image-to-Image / reference portraits)
# Sign up at: https://runwayml.com/
RUNWAY_API_KEY=

# [FRONTEND - React / Vite]
# Ideogram API Key (Optional: for premium tier text-to-image)
# Sign up at: https://ideogram.ai/
VITE_IDEOGRAM_API_KEY=

# Google Gemini API Key (For smart prompt enhancement and image generation)
GEMINI_API_KEY=
